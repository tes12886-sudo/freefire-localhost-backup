<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/picker_item_icon"
            android:layout_width="@dimen/com_garena_android_msdk_dialog_icon_size"
            android:layout_height="@dimen/com_garena_android_msdk_dialog_icon_size"
            android:layout_marginLeft="5dp"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="@dimen/com_garena_android_msdk_text_size_picker"
            android:textColor="@color/picker_header_text_color"
            android:gravity="center_vertical"
            android:id="@+id/picker_item_desc"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="20dp"
            android:text="100"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/currency_amount"
            android:background="@drawable/msdk_blue_btn"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp">
            <TextView
                android:textSize="@dimen/com_garena_android_msdk_text_size_picker"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/currency_amount_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:text="$20000000"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/promotionTextIcon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:src="@drawable/msdk_icon_promo"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
</FrameLayout>
